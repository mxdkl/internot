// Re-partnering after a separation (R1c, R1d).
//
// Annual hazard that a separated person starts a new union:
//   duration(years since separation) · age_factor(age) · male_factor (men)
//   · era(year), capped at `cap`.
// Provisional. Targets (research/2026-09-30-remarriage-targets.md):
// - NSFG 1995: 15 / 39 / 54 / 75% of divorced women (under 45) remarried
//   within 1 / 3 / 5 / 10 years;
// - lower after a separation at 25+;
// - men re-partner more (Pew: 64% against 52% of the previously married);
// - recalibrated (R1d) to living with a spouse or partner by age (Census A1
//   plus UC3), cohabitation included.
(
    // By years since the separation (inclusive upper bounds).
    duration: (
        steps: [(0, 0.0), (1, 0.15), (3, 0.14), (5, 0.13), (10, 0.12), (20, 0.08)],
        above: 0.05,
    ),
    // By age (inclusive upper bounds). Smooth decline with no cutoff; the
    // code stops at 95, where the hazard is negligible (a technical bound
    // for the death draw's fast path, not a rule about people).
    age_factor: (
        steps: [(34, 1.0), (44, 0.75), (54, 0.6), (64, 0.5), (74, 0.25), (84, 0.1)],
        above: 0.03,
    ),
    male_factor: 1.2,
    era: [
        (1900, 1.3),
        (1960, 1.3),
        (1990, 1.1),
        (2020, 1.0),
        (2100, 1.0),
    ],
    cap: 0.9,
)
