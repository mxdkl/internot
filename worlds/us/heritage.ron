            founder_share: [(1840, 2.56), (1900, 0.35), (1950, 0.25)],
            immigrant_share: [
                (1845, 0.0), (1855, 0.0), (1865, 0.0), (1875, 0.0), (1885, 0.0),
                (1895, 0.0), (1905, 0.0), (1915, 0.0), (1925, 0.0), (1935, 0.0),
