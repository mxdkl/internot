                male: [(1840, 0.012), (1960, 0.013), (1980, 0.09), (2008, 0.24), (2015, 0.26), (2100, 0.28)],
            ),
            fertility: [(1850, 1.362), (1870, 1.555), (1880, 1.566), (1900, 1.477), (1910, 1.300), (1920, 1.132), (1930, 1.192), (1940, 1.257), (1950, 1.278), (1960, 1.244), (1970, 1.257), (1980, 1.277), (1990, 1.226), (2000, 1.058), (2007, 1.009), (2010, 1.021), (2015, 1.011), (2019, 1.041), (2024, 0.938)],
