// Work (L6): careers as dated spells (jobs, unemployment, time out of the
// labour force, retirement), the occupation and industry of each job, its
// employer and pay. Data and sources: research/2026-09-29-work-and-
// organizations.md (sections cited as §); occupation, wage and industry
// tables from the ACS 2023 PUMS (internot_society/data/distill_work.py).
(
    data: "data/work.bin",

    // Job lengths (years): lognormal, its log-mean and log-sd interpolated
    // by the age at the job's start (§8.4, fitted to BLS tenure by age and
    // NLSY79 completed durations: of jobs begun at 18–24, 61% end within a
    // year and 87% within 5; at 45–54, 21% and 56%).
    job_years: [(18, -0.53, 1.90), (50, 1.354, 1.68)],
    // After a job: the share going straight to the next (Fallick &
    // Fleischman: two-fifths of new jobs are employer changes; §4.3), else
    // unemployed or out of the labour force.
    direct: 0.45,
    // Unemployment (weeks): lognormal, median 11.4, log-sd 1.29 (§4.5,
    // CPS; completed spells are shorter than the stock).
    unemployment_weeks: (median: 9.0, sigma: 1.2),
    // A spell out of the labour force between jobs (training, caring,
    // illness): its probability at a job's end, and its length in years
    // (lognormal).
    break_share: 0.08,
    break_years: (median: 1.0, sigma: 0.9),

    // Women leaving the labour force at their first union or first birth
    // (whichever first), by birth cohort, and the share of those who come
    // back once their youngest child is about `return_child_age`; and the
    // share of women who stay home before their first union (helping their
    // parents' household; single women's participation was about 43% in
    // 1900, 51% in 1950, 66% by 2000). Fitted to women's participation:
    // about 20% (1900), 33% (1950), 43% (1970), 57% (1990) of women 16+;
    // prime age 35% (1950) to 77% (2000).
    homemaker: [(1850, 0.85), (1900, 0.80), (1925, 0.70), (1940, 0.55), (1955, 0.38), (1970, 0.25), (1990, 0.20)],
    homemaker_returns: [(1850, 0.10), (1900, 0.25), (1915, 0.40), (1930, 0.55), (1950, 0.65), (1970, 0.60)],
    return_child_age: 6.0,
    homemaker_single: [(1850, 0.50), (1890, 0.40), (1920, 0.25), (1940, 0.12), (1960, 0.05)],

    // Students' jobs, from 16 until schooling ends and during college and
    // graduate school: the share of students working at a time, by year
    // (CPS and NCES, summer jobs included: about a third of high school and
    // full-time college students in 1970, half of college students about
    // 2000, under two-fifths since 2010), their jobs' lengths (lognormal,
    // years) and hours (a share of full time).
    students: (
        share: [(1900, 0.25), (1940, 0.25), (1960, 0.30), (1975, 0.38), (1990, 0.44), (2000, 0.38), (2010, 0.28), (2023, 0.24)],
        job_years: (median: 0.4, sigma: 0.9),
        hours: 0.5,
    ),

    // Leaving the labour force for disability or ill health: a yearly
    // hazard by age (SSA: disability awards about 0.3% a year in the 30s
    // rising to 1.5% in the early 60s), its scale by year (disability
    // insurance from 1956; prime-age men out of the labour force rose from
    // 3% in the 1960s to 11% in the 2020s), the share who return, and how
    // long they are out (lognormal, years).
    disability: (
        hazard: (steps: [(29, 0.002), (39, 0.004), (49, 0.007), (59, 0.012)], above: 0.015),
        era: [(1950, 0.3), (1965, 0.5), (1980, 0.8), (2000, 1.0), (2023, 1.2)],
        returns: 0.3,
        years: (median: 1.5, sigma: 0.8),
    ),

    // Retirement: of each birth cohort, the share still working at each age
    // of those working at 50, by sex; between cohorts the age of each
    // quantile interpolates. From CPS participation by age over
    // participation at 45–54 (men 65+: 46% in 1950, 27% in 1970, 18% in
    // 2000, 24% in 2023; 55–64: 87%, 83%, 67%, 71%), net of disability.
    // Before Social Security most men worked into old age (§4.5).
    retirement: (
        female: [
            (1860, [(50.0, 1.0), (55.0, 0.97), (58.0, 0.94), (60.0, 0.91), (62.0, 0.86), (65.0, 0.75), (67.0, 0.64), (70.0, 0.50), (75.0, 0.32), (80.0, 0.16), (90.0, 0.0)]),
            (1890, [(50.0, 1.0), (55.0, 0.96), (58.0, 0.92), (60.0, 0.89), (62.0, 0.83), (65.0, 0.68), (67.0, 0.56), (70.0, 0.42), (75.0, 0.24), (80.0, 0.11), (90.0, 0.0)]),
            (1905, [(50.0, 1.0), (55.0, 0.95), (58.0, 0.90), (60.0, 0.86), (62.0, 0.77), (65.0, 0.55), (67.0, 0.42), (70.0, 0.28), (75.0, 0.14), (80.0, 0.06), (90.0, 0.0)]),
            (1920, [(50.0, 1.0), (55.0, 0.93), (58.0, 0.86), (60.0, 0.80), (62.0, 0.66), (65.0, 0.44), (67.0, 0.35), (70.0, 0.25), (75.0, 0.13), (80.0, 0.06), (90.0, 0.0)]),
            (1935, [(50.0, 1.0), (55.0, 0.93), (58.0, 0.86), (60.0, 0.79), (62.0, 0.64), (65.0, 0.44), (67.0, 0.35), (70.0, 0.26), (75.0, 0.14), (80.0, 0.06), (90.0, 0.0)]),
            (1950, [(50.0, 1.0), (55.0, 0.95), (58.0, 0.89), (60.0, 0.84), (62.0, 0.72), (65.0, 0.54), (67.0, 0.45), (70.0, 0.34), (75.0, 0.19), (80.0, 0.09), (90.0, 0.0)]),
            (1965, [(50.0, 1.0), (55.0, 0.95), (58.0, 0.90), (60.0, 0.86), (62.0, 0.76), (65.0, 0.58), (67.0, 0.48), (70.0, 0.36), (75.0, 0.20), (80.0, 0.09), (90.0, 0.0)]),
        ],
        male: [
            (1860, [(50.0, 1.0), (55.0, 0.99), (58.0, 0.97), (60.0, 0.96), (62.0, 0.93), (65.0, 0.85), (67.0, 0.76), (70.0, 0.62), (75.0, 0.42), (80.0, 0.22), (90.0, 0.0)]),
            (1890, [(50.0, 1.0), (55.0, 0.98), (58.0, 0.96), (60.0, 0.94), (62.0, 0.90), (65.0, 0.78), (67.0, 0.66), (70.0, 0.50), (75.0, 0.30), (80.0, 0.15), (90.0, 0.0)]),
            (1905, [(50.0, 1.0), (55.0, 0.97), (58.0, 0.94), (60.0, 0.91), (62.0, 0.85), (65.0, 0.62), (67.0, 0.48), (70.0, 0.33), (75.0, 0.18), (80.0, 0.08), (90.0, 0.0)]),
            (1920, [(50.0, 1.0), (55.0, 0.95), (58.0, 0.90), (60.0, 0.85), (62.0, 0.72), (65.0, 0.48), (67.0, 0.38), (70.0, 0.27), (75.0, 0.15), (80.0, 0.07), (90.0, 0.0)]),
            (1935, [(50.0, 1.0), (55.0, 0.95), (58.0, 0.88), (60.0, 0.82), (62.0, 0.66), (65.0, 0.46), (67.0, 0.37), (70.0, 0.27), (75.0, 0.15), (80.0, 0.07), (90.0, 0.0)]),
            (1950, [(50.0, 1.0), (55.0, 0.96), (58.0, 0.91), (60.0, 0.86), (62.0, 0.74), (65.0, 0.56), (67.0, 0.47), (70.0, 0.36), (75.0, 0.21), (80.0, 0.10), (90.0, 0.0)]),
            (1965, [(50.0, 1.0), (55.0, 0.96), (58.0, 0.92), (60.0, 0.88), (62.0, 0.78), (65.0, 0.60), (67.0, 0.50), (70.0, 0.38), (75.0, 0.22), (80.0, 0.10), (90.0, 0.0)]),
        ],
    ),

    // Occupations: the ACS 2023 shares by sex, age band and education,
    // each SOC major group scaled by its era factor (relative to 2023) at
    // the job's start, so farming and factory work dominate early and
    // computing appears late (Census occupational series: farm occupations
    // 38% of workers in 1900, 12% in 1950, 3% in 1980; operatives and
    // laborers a quarter of workers to 1950; clerical work peaking about
    // 1980).
    era_factors: [
        (group: 11, factor: [(1900, 0.5), (1950, 0.7), (1980, 0.8), (2023, 1.0)]),
        (group: 13, factor: [(1900, 0.2), (1950, 0.4), (1980, 0.7), (2023, 1.0)]),
        (group: 15, factor: [(1950, 0.02), (1970, 0.1), (1990, 0.4), (2023, 1.0)]),
        (group: 17, factor: [(1900, 0.3), (1950, 0.7), (1980, 0.9), (2023, 1.0)]),
        (group: 19, factor: [(1900, 0.2), (1950, 0.5), (1980, 0.8), (2023, 1.0)]),
        (group: 21, factor: [(1900, 0.5), (1950, 0.6), (1980, 0.9), (2023, 1.0)]),
        (group: 25, factor: [(1900, 0.6), (1950, 0.8), (1980, 1.0), (2023, 1.0)]),
        (group: 29, factor: [(1900, 0.25), (1950, 0.45), (1980, 0.7), (2023, 1.0)]),
        (group: 31, factor: [(1900, 0.2), (1950, 0.4), (1980, 0.7), (2023, 1.0)]),
        (group: 37, factor: [(1900, 1.5), (1950, 1.2), (1980, 1.1), (2023, 1.0)]),
        (group: 39, factor: [(1900, 3.0), (1950, 1.5), (1980, 0.9), (2023, 1.0)]),
        (group: 41, factor: [(1900, 0.6), (1950, 0.9), (1980, 1.0), (2023, 1.0)]),
        (group: 43, factor: [(1900, 0.4), (1950, 1.3), (1980, 1.5), (2023, 1.0)]),
        (group: 45, factor: [(1900, 38.0), (1920, 18.0), (1940, 8.0), (1950, 5.0), (1960, 3.0), (1970, 1.8), (1990, 1.3), (2023, 1.0)]),
        (group: 49, factor: [(1900, 0.6), (1950, 1.2), (1980, 1.2), (2023, 1.0)]),
        (group: 51, factor: [(1900, 3.0), (1950, 3.0), (1980, 2.0), (2023, 1.0)]),
        (group: 53, factor: [(1900, 1.3), (1950, 1.5), (1980, 1.2), (2023, 1.0)]),
    ],
    // At a job change, the share switching occupation (the rest keep their
    // job family; §3: families persist across jobs). A first job before 25
    // comes from the young workers' table; the next job after 25 from the
    // adults'.
    switch_occupation: 0.25,

    // Pay: the occupation's median wage of full-time year-round workers in
    // 2023 dollars (ACS), times an experience curve (log points a year of
    // experience, to a peak), times a real-wage index by year (2023 = 1;
    // average real wages roughly ×5.5 since 1900, BLS/HSUS; about ×1.4
    // from 1850 to 1900), with the occupation's log-sd. Nominal pay uses
    // the CPI-U (annual averages, BLS; 1982–84 = 100); before 1913 the
    // Minneapolis Fed's historical index (1967 = 100, times 0.334).
    experience: (per_year: 0.025, peak_years: 25.0, start: -0.35),
    real_wage: [(1850, 0.13), (1870, 0.15), (1890, 0.17), (1900, 0.18), (1920, 0.25), (1940, 0.35), (1950, 0.45), (1960, 0.58), (1970, 0.72), (1980, 0.78), (1990, 0.83), (2000, 0.92), (2010, 0.96), (2023, 1.0)],
    cpi: [(1800, 17.0), (1810, 15.7), (1820, 14.0), (1830, 10.7), (1840, 10.0), (1850, 8.4), (1855, 9.4), (1860, 9.0), (1863, 12.4), (1865, 15.4), (1870, 12.7), (1875, 11.0), (1880, 9.7), (1885, 9.0), (1890, 9.0), (1895, 8.4), (1900, 8.4), (1905, 9.0), (1910, 9.4), (1913, 9.9), (1918, 15.1), (1920, 20.0), (1925, 17.6), (1930, 16.7), (1933, 13.0), (1940, 14.0), (1945, 18.1), (1950, 24.1), (1960, 29.6), (1970, 38.8), (1980, 82.4), (1990, 130.7), (2000, 172.2), (2010, 218.1), (2020, 258.8), (2023, 304.7), (2025, 321.0)],

    // Employers: establishments by size class (CBP 2022: shares of
    // employment in establishments of 1–4, 5–9, 10–19, 20–49, 50–99,
    // 100–249, 250–499, 500–999 and 1,000+ employees, and each class's mean
    // size); a job's establishment is in the home county, or with
    // `other_county` another county of the home's commuting zone (by
    // weight).
    size_classes: [
        (share: 0.05, mean: 2.2),
        (share: 0.06, mean: 6.8),
        (share: 0.09, mean: 13.6),
        (share: 0.15, mean: 30.5),
        (share: 0.12, mean: 69.0),
        (share: 0.15, mean: 152.0),
        (share: 0.10, mean: 342.0),
        (share: 0.08, mean: 683.0),
        (share: 0.20, mean: 2400.0),
    ],
    other_county: 0.25,

    // Employer names (generic patterns only, no real brands). A line of
    // business that names a place (the Census industry index's "Pizza
    // parlor", "Grocery store") gives the name `place_share` of the time;
    // otherwise the sector's patterns, by the longest listed NAICS recode
    // prefix of the industry, `large` ones from size class `large_from`
    // (250+ employees). {s} a surname, {t} another, {p} the county's name,
    // {l} the line of business, {x} a corporate suffix.
    names: (
        place_share: 0.6,
        place: ["{s}'s {l}", "{s} {l}", "{p} {l}", "The {p} {l}"],
        // Places that are institutions take the county's name, never a
        // family's ("Jefferson Private Hospital", not "Stokes's").
        civic_nouns: ["hospital", "bank", "school", "academy", "college", "library", "museum", "clinic", "center", "station", "plant", "mill", "terminal", "warehouse", "laboratory", "sanatorium", "depot", "yard", "agency", "office", "home", "camp", "club", "arena", "stadium"],
        civic: ["{p} {l}", "The {p} {l}"],
        large_from: 6,
        suffixes: ["Inc.", "LLC", "Co.", "Corporation", "Group", "Company"],
        sectors: [
            (naics: "", small: ["{s} & Associates", "{s} {l}", "{s} Services", "{s} & Sons"], large: ["{p} {l} {x}", "{s} {x}"]),
            (naics: "111", small: ["{s} Farms", "{s} Family Farm", "{p} Valley Farms", "{s} Brothers Farms", "{s} Orchards", "{s} Growers"], large: ["{p} Produce Company", "{p} Growers Cooperative"]),
            (naics: "112", small: ["{s} Ranch", "{s} Dairy", "{s} Cattle Company", "{s} Poultry Farm", "{p} Livestock"], large: ["{p} Farms {x}"]),
            (naics: "113", small: ["{s} Logging", "{s} Timber Company", "{p} Forest Products"]),
            (naics: "114", small: ["{s} Fisheries", "{s} Boat Company", "{p} Seafood"]),
            (naics: "115", small: ["{s} Farm Services", "{p} Ag Services", "{s} Custom Harvesting"]),
            (naics: "21", small: ["{s} Oil & Gas", "{p} Stone & Gravel", "{s} Drilling", "{p} Energy"], large: ["{p} Coal Company", "{p} Mining Corporation", "{p} Petroleum Company"]),
            (naics: "22", small: ["{p} Water Department", "{p} Electric Cooperative", "{p} Gas Company"], large: ["{p} Power & Light", "{p} Energy Company", "{p} Utilities"]),
            (naics: "23", small: ["{s} Construction", "{s} & Sons Contracting", "{s} Builders", "{s} Brothers Construction", "{s} Plumbing", "{s} Electric", "{s} Roofing", "{s} Paving"], large: ["{p} Construction Company", "{s} Construction Group"]),
            (naics: "3", small: ["{s} Manufacturing", "{s} Industries", "{s} Products", "{p} Manufacturing", "{s} & Sons"], large: ["{p} Manufacturing Company", "{s} Industries {x}", "{p} Works", "{s} Products Corporation"]),
            (naics: "311", small: ["{s} Foods", "{p} Bakery", "{s} Packing Company", "{p} Creamery"], large: ["{p} Foods {x}", "{s} Packing Company"]),
            (naics: "312", small: ["{s} Bottling", "{p} Brewing Company", "{s} Vineyards"], large: ["{p} Beverage Company"]),
            (naics: "42", small: ["{s} Supply", "{s} Distributors", "{p} Wholesale", "{s} & Co."], large: ["{p} Supply Company", "{s} Distribution {x}"]),
            (naics: "4", small: ["{s}'s", "{s} & Sons", "{p} Supply", "{s} Brothers"], large: ["{p} Superstore", "{p} Shopping Center"]),
            (naics: "4411", small: ["{s} Motors", "{s} Auto Sales", "{p} Motors"], large: ["{p} Auto Mall"]),
            (naics: "445", small: ["{s}'s Market", "{p} Grocery", "{s} Food Store"], large: ["{p} Supermarket"]),
            (naics: "481", small: ["{p} Air Service", "{s} Aviation"], large: ["{p} Airlines"]),
            (naics: "482", small: ["{p} Railroad"], large: ["{p} Rail Lines", "{p} & Western Railroad"]),
            (naics: "484", small: ["{s} Trucking", "{s} Freight Lines", "{p} Hauling", "{s} Transport", "{s} Moving & Storage"], large: ["{p} Freight {x}"]),
            (naics: "485", small: ["{p} Transit", "{p} Bus Lines", "{s} Taxi", "{p} Coach Company"]),
            (naics: "48", small: ["{s} Logistics", "{p} Distribution Center", "{s} Warehousing", "{p} Storage"]),
            (naics: "49", small: ["{s} Logistics", "{p} Distribution Center", "{s} Warehousing", "{p} Storage"]),
            (naics: "491", small: ["{p} Post Office"]),
            (naics: "51", small: ["{p} Media", "{p} Publishing", "{s} Communications", "{p} Telephone Company", "The {p} Herald", "The {p} Gazette", "{p} Broadcasting"], large: ["{p} Communications {x}"]),
            (naics: "52", small: ["{s} Financial", "{s} Capital", "{p} Savings & Loan", "{p} Credit Union", "First {p} Bank", "{p} Trust Company"], large: ["First National Bank of {p}", "{p} Bank & Trust"]),
            (naics: "524", small: ["{s} Insurance Agency", "{p} Mutual Insurance", "{s} & Associates Insurance"], large: ["{p} Mutual Insurance Company"]),
            (naics: "53", small: ["{s} Realty", "{p} Properties", "{s} Real Estate", "{s} Rentals", "{p} Property Management"]),
            (naics: "54", small: ["{s} & Associates", "{s} Consulting", "{s} Partners", "{s} Group"], large: ["{p} Consulting Group", "{s} {x}"]),
            (naics: "5411", small: ["{s} & {t}", "{s} Law Office", "{s} Law Group", "{s}, {t} & Associates"], large: ["{s} & {t} LLP"]),
            (naics: "5412", small: ["{s} & Associates CPAs", "{s} Accounting", "{s} Tax Service"]),
            (naics: "5413", small: ["{s} Engineering", "{s} Architects", "{p} Surveying"], large: ["{s} Engineering Group"]),
            (naics: "5415", small: ["{s} Software", "{p} Data Systems", "{s} Technologies", "{s} Solutions"], large: ["{p} Systems {x}"]),
            (naics: "5418", small: ["{s} Advertising", "{s} Marketing Group"]),
            (naics: "55", small: ["{p} Holdings", "{s} Holdings {x}"]),
            (naics: "56", small: ["{s} Services", "{s} Business Services", "{p} Office Services"], large: ["{p} Services {x}"]),
            (naics: "5613", small: ["{p} Staffing", "{s} Personnel", "{s} Employment Agency"], large: ["{p} Staffing {x}"]),
            (naics: "5616", small: ["{p} Security", "{s} Security Services", "{s} Protective Services"], large: ["{p} Security {x}"]),
            (naics: "5617", small: ["{s} Cleaning Services", "{p} Janitorial", "{s} Pest Control", "{s} Building Maintenance"], large: ["{p} Facility Services"]),
            (naics: "56173", small: ["{s} Landscaping", "{s} Lawn Care", "{p} Tree Service", "{s} Grounds Maintenance"]),
            (naics: "562", small: ["{p} Waste Services", "{p} Recycling", "{s} Disposal"]),
            (naics: "61", small: ["{p} Learning Center", "{s} Academy", "{p} Institute", "{p} School of Business"]),
            (naics: "62", small: ["{p} Medical Center", "{s} Family Practice", "{p} Health Clinic", "{p} Care Center", "{s} Medical Group"], large: ["{p} Regional Medical Center", "{p} Health System"]),
            (naics: "6211", small: ["{s} Family Medicine", "{s} Medical Group", "{p} Physicians"]),
            (naics: "6212", small: ["{s} Dental", "{p} Dental Associates", "{s} Family Dentistry"]),
            (naics: "622", small: ["{p} General Hospital", "{p} Memorial Hospital", "St. {s} Hospital", "{p} Regional Medical Center"], large: ["{p} General Hospital", "{p} Memorial Hospital", "{p} Regional Medical Center"]),
            (naics: "623", small: ["{p} Nursing Home", "{p} Care Center", "{s} Manor", "{p} Health and Rehabilitation"]),
            (naics: "624", small: ["{p} Family Services", "{p} Community Services", "{s} Child Care", "{p} Senior Center"]),
            (naics: "6244", small: ["{s} Child Care", "Little {s} Daycare", "{p} Learning Center"]),
            (naics: "71", small: ["{p} Recreation Center", "{s} Fitness", "{p} Golf Club", "{p} Bowling Lanes", "{p} Country Club"]),
            (naics: "721", small: ["{p} Inn", "{p} Motel", "{s} Lodge", "{p} Hotel"], large: ["{p} Grand Hotel", "{p} Resort"]),
            (naics: "722", small: ["{s}'s Diner", "{s}'s Grill", "{p} Kitchen", "{s}'s Cafe", "{p} Family Restaurant"]),
            (naics: "811", small: ["{s}'s Auto Repair", "{s} Auto Service", "{p} Collision", "{s} Garage", "{s} Repair Service"]),
            (naics: "812", small: ["{s} Services", "{p} Parking", "{s} Pet Grooming"]),
            (naics: "8121", small: ["{s}'s Salon", "{s}'s Barber Shop", "{p} Nail Salon", "{s} Day Spa"]),
            (naics: "8122", small: ["{s} Funeral Home", "{s} & {t} Funeral Home", "{p} Memorial Chapel"]),
            (naics: "8123", small: ["{p} Cleaners", "{s} Dry Cleaning", "{p} Laundry"], large: ["{p} Linen Service"]),
            (naics: "813", small: ["{p} Community Church", "First Baptist Church of {p}", "{p} Foundation", "{p} Association", "St. {s} Parish"]),
            (naics: "814", small: ["The {s} Household", "The {s} Family"]),
            (naics: "92", small: ["{p} County"]),
        ],
    ),
)
