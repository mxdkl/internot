// Mortality: a Siler hazard by sex, scaled by era.
//
// Force of mortality at exact age x in calendar year t:
//   infant(t) · e^(−infant_decay·x) + background(t) + old(t) · e^(old_slope·x)
// where each term is its base value times that term's era multiplier.
// The probability of dying within a year of age is the hazard integrated in
// closed form, 1 − e^(−H).
(
    infant_decay: 5.0,
    base: (
        infant: 0.030,
        background: (female: 0.0005, male: 0.0011),
        old: (female: 2.3e-5, male: 4.4e-5),
        old_slope: (female: 0.092, male: 0.087),
    ),

    // Era multipliers, relative to a 2024 US base, interpolated geometrically
    // (log-linearly) between anchor years and constant outside them.
    // Calibrated (R1 plan) to life expectancy at birth, women / men:
    // about 40 / 37 (1840), 48 / 45 (1900), 74 / 70 (1950), 81 / 77 (2024).
    multipliers: [
        (year: 1840, infant: 42.0, background_female: 22.0, background_male: 11.0, old: 2.3),
        (year: 1900, infant: 28.0, background_female: 17.0, background_male: 8.5, old: 1.9),
        (year: 1950, infant: 5.0, background_female: 3.5, background_male: 2.4, old: 1.45),
        (year: 2000, infant: 1.3, background_female: 1.15, background_male: 1.2, old: 1.18),
        (year: 2024, infant: 1.0, background_female: 1.0, background_male: 1.0, old: 1.0),
        (year: 2100, infant: 0.5, background_female: 0.7, background_male: 0.7, old: 0.72),
    ],
)
