// A small US world for exhaustive tests: 1900 to 1990, about 300 founder
// births a year, with rare things raised so the checks cover them. Every
// section it doesn't name comes from `us`.
(
    name: "United States (tiny test world)",
    description: "The us pack at test scale: 1900–1990, 300 founder births a year, two equal regions, boosted same-sex and cross-heritage unions.",
    extends: Some("us"),

    timeline: (
        first_year: 1900,
        last_year: 1990,
        founder_max_age: 80,
    ),
    founders: (
        births: 300.0,
        growth: 0.01,
    ),
    regions: [
        (id: "east", founder_weight: 0.5, immigrant_weight: 0.6),
        (id: "west", founder_weight: 0.5, immigrant_weight: 0.4),
    ],
    test_boosts: (
        same_sex: 10.0,
        heritage_floor: 0.08,
        open_market: 4.0,
    ),
)
